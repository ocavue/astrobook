{
  "name": "@astrobook/ui",
  "type": "module",
  "version": "0.13.3",
  "description": "Internal package for Astrobook",
  "author": "ocavue <ocavue@gmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/ocavue",
  "homepage": "https://github.com/ocavue/astrobook#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ocavue/astrobook.git"
  },
  "bugs": "https://github.com/ocavue/astrobook/issues",
  "keywords": [],
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./components/*": {
      "default": "./src/components/*"
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "typesVersions": {
    "*": {
      ".": [
        "./src/index.ts"
      ],
      "./components/*": [
        "./src/components/*"
      ]
    }
  },
  "files": [
    "src"
  ],
  "dependencies": {
    "@astrobook/core": "workspace:*",
    "@astrobook/types": "workspace:*",
    "astro-theme-toggle": "^0.8.1",
    "just-group-by": "^2.2.0"
  },
  "peerDependencies": {
    "astro": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "astro": "^7.2.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
