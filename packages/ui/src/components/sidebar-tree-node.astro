---
import type { TreeNode } from './build-tree'
import config from 'virtual:astrobook/global-config.mjs'
import Icon from './icon.astro'
import { buildPath } from './build-path'
import { getCollapseDuration } from './collapse-duration'

interface Props {
  node: TreeNode
}

const { node } = Astro.props

const collapseDuration = getCollapseDuration(node)
---

{
  node.type === 'directory' && (
    <astrobook-sidebar-node>
      <details
        open
        data-astrobook-collapsible
        data-id={`dir:${node.name}`}
        data-search-text={node.searchText}
        style={`--astrobook-collapse-duration: ${collapseDuration}ms`}
      >
        <summary
          class:list={[
            'astrobook-sidebar-link',
            'astrobook-sidebar-collapsible-link',
            'astrobook-focus-ring',
          ]}
        >
          <Icon name="chevron-down" data-astrobook-chevron />
          <span>{node.name}</span>
        </summary>
        <div class="astrobook-sidebar-children">
          {node.children.map((child) => (
            <Astro.self node={child} />
          ))}
        </div>
      </details>
    </astrobook-sidebar-node>
  )
}

{
  node.type === 'module' && (
    <astrobook-sidebar-node>
      <details
        open
        data-astrobook-collapsible
        data-id={`module:${node.id}`}
        data-search-text={node.searchText}
        style={`--astrobook-collapse-duration: ${collapseDuration}ms`}
      >
        <summary
          class:list={[
            'astrobook-sidebar-link',
            'astrobook-sidebar-collapsible-link',
            'astrobook-focus-ring',
          ]}
        >
          <Icon name="collection" />
          <span>{node.name}</span>
        </summary>
        <div class="astrobook-sidebar-children">
          {node.children.map((child) => (
            <Astro.self node={child} />
          ))}
        </div>
      </details>
    </astrobook-sidebar-node>
  )
}

{
  node.type === 'story' && (
    <a
      href={buildPath(config.dashboardBase, node.id)}
      data-astrobook-story-link
      data-story-id={node.id}
      data-search-text={node.searchText}
      class:list={[
        'astrobook-sidebar-link',
        'astrobook-focus-ring',
        // The inline script in sidebar-tree.astro swaps this for the active
        // class when this story is the one being displayed.
        'astrobook-sidebar-story-link-inactive',
      ]}
    >
      <Icon name="story" />
      <span>{node.name}</span>
    </a>
  )
}

<style is:global>
  astrobook-sidebar-node {
    display: contents;
  }

  .astrobook-sidebar-children {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding-left: 0.75rem;
  }

  .astrobook-sidebar-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    -webkit-user-select: none;
    user-select: none;
    list-style-type: none;
    border-radius: var(--astrobook-radius);
    padding: 0.25rem 0.5rem;
    font-size: 0.875rem;
    line-height: 1.25rem;
    text-decoration: none;
    transition: var(--astrobook-transition);
  }

  .astrobook-sidebar-link .astrobook-icon {
    width: 0.875rem;
    height: 0.875rem;
    flex-shrink: 0;
    color: var(--astrobook-color-text-subtle);
  }

  .astrobook-sidebar-collapsible-link {
    color: var(--astrobook-color-text-muted);
  }

  .astrobook-sidebar-collapsible-link:hover {
    background-color: var(--astrobook-color-surface-hover);
    color: var(--astrobook-color-text-muted-hover);
  }

  .astrobook-sidebar-story-link-inactive {
    color: var(--astrobook-color-text-secondary);
  }

  .astrobook-sidebar-story-link-inactive:hover {
    background-color: var(--astrobook-color-surface-hover);
    color: var(--astrobook-color-text);
  }

  .astrobook-sidebar-story-link-active {
    background-color: var(--astrobook-color-emphasis);
    color: var(--astrobook-color-on-emphasis);
  }

  .astrobook-sidebar-story-link-active:hover {
    background-color: var(--astrobook-color-emphasis-hover);
    color: var(--astrobook-color-on-emphasis);
  }

  details[data-astrobook-collapsible] {
    interpolate-size: allow-keywords;
  }

  details[data-astrobook-collapsible]::details-content {
    height: 0;
    overflow: clip;
    transition:
      height var(--astrobook-collapse-duration) var(--astrobook-easing-collapse),
      content-visibility var(--astrobook-collapse-duration)
        var(--astrobook-easing-collapse) allow-discrete;
  }

  details[data-astrobook-collapsible][open]::details-content {
    height: auto;
  }

  [data-astrobook-chevron] {
    transform: rotate(-90deg);
    transition: transform var(--astrobook-collapse-duration)
      var(--astrobook-easing-collapse);
  }

  details[data-astrobook-collapsible][open]
    > summary
    > [data-astrobook-chevron] {
    transform: rotate(0deg);
  }
</style>
