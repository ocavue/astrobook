---
interface Props {
  id?: string
  href?: string
  title: string
}

const Element = Astro.props.href ? 'a' : 'button'
---

<Element
  id={Astro.props.id}
  href={Astro.props.href}
  class="astrobook-sidebar-button astrobook-focus-ring"
  title={Astro.props.title}
>
  <span class="astrobook-visually-hidden">{Astro.props.title}</span>
  <slot />
</Element>

<style is:global>
  .astrobook-sidebar-button {
    box-sizing: border-box;
    display: block;
    cursor: pointer;
    border-width: 0;
    border-radius: var(--astrobook-radius);
    background-color: transparent;
    padding: 0.5rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--astrobook-color-text-muted);
    text-decoration: none;
    transition: var(--astrobook-transition);
  }

  .astrobook-sidebar-button:hover {
    transform: scale(1.1);
    color: var(--astrobook-color-emphasis);
  }

  .astrobook-sidebar-button[data-active] {
    background-color: var(--astrobook-color-surface-hover);
    color: var(--astrobook-color-emphasis);
  }

  .astrobook-sidebar-button .astrobook-icon {
    box-sizing: border-box;
    display: block;
    width: 1rem;
    height: 1rem;
  }

  .astrobook-visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>
