---
import '../style.css'
import Sidebar from './sidebar.astro'
import SidebarResizeHandle from './sidebar-resize-handle.astro'
import { ThemeScript } from 'astro-theme-toggle/components'
import CustomHead from 'virtual:astrobook/components/head.mjs'
import config from 'virtual:astrobook/global-config.mjs'

import { ClientRouter } from 'astro:transitions'

interface Props {
  story: string | undefined
  hasSidebar: boolean
}

const hasSidebar = Astro.props.hasSidebar ?? true
const DEFAULT_SIDEBAR_WIDTH = 300
const DEFAULT_SIDEBAR_RESIZING = false
---

<html
  lang="en"
  data-astrobook-root
  data-active-story={Astro.props.story ?? ''}
  data-sidebar-width={DEFAULT_SIDEBAR_WIDTH}
  data-sidebar-resizing={DEFAULT_SIDEBAR_RESIZING ? '' : undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{config.title}</title>
    <ThemeScript />
    <script>
      import { initThemeMessage } from './theme-message'
      initThemeMessage()
    </script>
    <CustomHead />
    <ClientRouter fallback="none" />
    <script is:inline>
      ;(() => {
        const STORAGE_KEY = 'astrobook-sidebar-width'
        const restoreWidth = () => {
          const width = parseFloat(localStorage.getItem(STORAGE_KEY) || '')
          if (width) {
            document.documentElement.dataset.sidebarWidth = String(width)
          }
        }

        restoreWidth()
        document.addEventListener('astro:after-swap', restoreWidth)
      })()
    </script>
  </head>
  <body class="astrobook-layout">
    {
      hasSidebar && (
        <>
          <div id="astrobook-sidebar">
            <Sidebar story={Astro.props.story} />
          </div>
          <SidebarResizeHandle />
        </>
      )
    }
    {
      /*
      Use `transition:animate="none"` here because we don't want the fade animation
      when switching between stories. Sadly this also removes the animation when toggling the light/dark theme.
      */
    }
    <main
      class="astrobook-main"
      transition:name="astrobook-main"
      transition:animate="none"
    >
      <slot />
    </main>
  </body>
</html>

<style is:global>
  html {
    /* Improve consistency of default fonts in all browsers. (https://github.com/sindresorhus/modern-normalize/issues/3) */
    font-family: var(--astrobook-font-family);

    /* Correct the line height in all browsers. */
    line-height: 1.15;

    /* Prevent adjustments of font size after orientation changes in iOS. */
    -webkit-text-size-adjust: 100%;
  }

  [data-astrobook-root] {
    box-sizing: border-box;
    height: 100%;
    max-height: 100vh;
    overflow: hidden;

    /* Kept in sync with `localStorage` by the sidebar resize handle */
    --astrobook-sidebar-width: attr(data-sidebar-width px);
  }

  [data-astrobook-root][data-sidebar-resizing] {
    cursor: ew-resize;
    -webkit-user-select: none;
    user-select: none;
  }

  .astrobook-layout {
    box-sizing: border-box;
    display: flex;
    flex-direction: row;
    align-items: stretch;
    justify-content: flex-start;
    max-height: 100%;
    min-height: 100%;
    margin: 0;
    padding: 0;
  }

  #astrobook-sidebar {
    display: flex;
    flex-shrink: 0;
    flex-direction: column;
    width: var(--astrobook-sidebar-width);
    min-width: 100px;
    max-width: calc(100vw - 100px);
    border-width: 0 1px 0 0;
    border-style: solid;
    border-color: var(--astrobook-color-border);
    background-color: var(--astrobook-color-surface);
  }

  .astrobook-main {
    box-sizing: border-box;
    flex: 1 1 0%;
    overflow: auto;
  }
</style>
