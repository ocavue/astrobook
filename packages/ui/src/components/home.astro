---
import config from 'virtual:astrobook/global-config.mjs'

const content = config.homeContent
const showBadges = !!(content.version || content.repo)
---

<div class="astrobook-home">
  <div class="astrobook-home-content">
    {
      content.title == null ? null : (
        <h1 class="astrobook-home-title">{content.title}</h1>
      )
    }
    {
      content.subtitle == null ? null : (
        <p class="astrobook-home-subtitle">{content.subtitle}</p>
      )
    }

    {
      showBadges && (
        <div class="astrobook-home-badges">
          {content.version && (
            <a
              href={content.version.href}
              target="_blank"
              rel="noopener noreferrer"
              class="astrobook-badge astrobook-badge-version"
            >
              {content.version.label}
            </a>
          )}
          {content.repo && (
            <a
              href={content.repo.href}
              target="_blank"
              rel="noopener noreferrer"
              class="astrobook-badge astrobook-badge-repo"
            >
              <span class="astrobook-icon astrobook-icon-star" />
              <span>{content.repo.label}</span>
            </a>
          )}
        </div>
      )
    }
  </div>
</div>
