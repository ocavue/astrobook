<div id="astrobook-search-panel">
  <div class="astrobook-search-row">
    <div class="astrobook-search-field">
      <span class="astrobook-icon astrobook-icon-search"></span>
      <input
        id="astrobook-search-input"
        type="text"
        placeholder="Search..."
        aria-label="Search stories"
        class="astrobook-search-input"
      />
    </div>
  </div>
</div>

<script>
  import { initSearch } from './sidebar-search-script'

  initSearch(document)
  document.addEventListener('astro:before-swap', (event) => {
    initSearch(event.newDocument)
  })
</script>
