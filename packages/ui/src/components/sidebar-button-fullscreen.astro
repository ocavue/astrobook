---
import '@astrobook/types'
import config from 'virtual:astrobook/global-config.mjs'

import SidebarButton from './sidebar-button.astro'
import { buildPath } from './build-path'

interface Props {
  story?: string
}
---

{
  Astro.props.story ? (
    <SidebarButton
      href={buildPath(config.storyBase, Astro.props.story)}
      title="Go full screen"
    >
      <span
        class:list={[
          ':uno: box-border block size-4',
          'astrobook-icon-lucide-square-arrow-out-up-right',
        ]}
      />
    </SidebarButton>
  ) : null
}
