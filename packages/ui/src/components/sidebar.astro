---
import SidebarButtonFullscreen from './sidebar-button-fullscreen.astro'
import SidebarButtonSearch from './sidebar-button-search.astro'
import SidebarButtonTheme from './sidebar-button-theme.astro'
import SidebarSearchPanel from './sidebar-search-panel.astro'
import SidebarTree from './sidebar-tree.astro'
import SidebarTitle from './sidebar-title.astro'

interface Props {
  story?: string
}
---

<nav class="astrobook-sidebar-nav">
  <div class="astrobook-sidebar-header">
    <SidebarTitle />
    <span class="astrobook-sidebar-spacer"></span>
    <SidebarButtonFullscreen story={Astro.props.story} />
    <SidebarButtonSearch />
    <SidebarButtonTheme />
  </div>
  <SidebarSearchPanel />
  <SidebarTree />
</nav>

<style is:global>
  .astrobook-sidebar-nav {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    max-height: 100%;
    min-height: 100%;
    overflow-y: hidden;
    padding: 0;
  }

  /* A divider between the header, the search panel and the story tree */
  .astrobook-sidebar-nav > * + * {
    border-width: 1px 0 0;
    border-style: solid;
    border-color: var(--astrobook-color-border);
  }

  .astrobook-sidebar-header {
    display: inline-flex;
    align-items: center;
    padding: 1rem 0.5rem;
  }

  .astrobook-sidebar-spacer {
    flex: 1 1 0%;
  }
</style>
