---
import '@astrobook/types'
import { Toggle } from 'astro-theme-toggle/components'
---

<span class="astrobook-theme-toggle-slot">
  <Toggle class="astrobook-sidebar-button astrobook-focus-ring" />
</span>

<style is:global>
  /* The toggle fills this box, so it lines up with the other sidebar buttons */
  .astrobook-theme-toggle-slot {
    box-sizing: border-box;
    width: 2rem;
    height: 2rem;
    min-width: 2rem;
  }
</style>
